#!/data/data/com.termux/files/usr/bin/bash
# Onyx Cloud — start.sh
# Jalanin server + ngrok sekaligus di 1 terminal

set -e

cd "$(dirname "$0")"

echo "🛑 Matiin proses lama..."
pkill -f "node server.js" 2>/dev/null || true
pkill -f "ngrok http" 2>/dev/null || true
sleep 2

echo "🚀 Jalanin Onyx server..."
node server.js > /data/data/com.termux/files/usr/tmp/onyx-server.log 2>&1 &
SERVER_PID=$!

echo "⏳ Tunggu server ready (5 detik)..."
sleep 5

# Cek server udah jalan apa belum
if ! curl -s -o /dev/null -w "%{http_code}" http://localhost:3000 | grep -q "200\|301\|302\|404"; then
  echo "❌ Server gagal start. Cek /data/data/com.termux/files/usr/tmp/onyx-server.log:"
  cat /data/data/com.termux/files/usr/tmp/onyx-server.log
  exit 1
fi

echo "✅ Server jalan di http://localhost:3000"

echo "🚀 Jalanin ngrok tunnel..."
ngrok http 3000 > /data/data/com.termux/files/usr/tmp/onyx-ngrok.log 2>&1 &
NGROK_PID=$!

sleep 4

echo ""
echo "════════════════════════════════════════"
echo "  ONYX CLOUD — RUNNING"
echo "════════════════════════════════════════"
echo ""

# Ambil URL ngrok dari API lokal
NGROK_URL=$(curl -s http://127.0.0.1:4040/api/tunnels 2>/dev/null | grep -o '"public_url":"https://[^"]*"' | head -1 | cut -d'"' -f4)

if [ -n "$NGROK_URL" ]; then
  echo "  🌐 Ngrok URL: $NGROK_URL"
else
  echo "  ⚠️  Ngrok URL gak kedeteksi. Cek http://127.0.0.1:4040"
fi

echo "  🖥️  Local: http://localhost:3000"
echo ""
echo "════════════════════════════════════════"
echo ""
echo "  📋 Server PID: $SERVER_PID"
echo "  📋 Ngrok PID:  $NGROK_PID"
echo ""
echo "  Tekan Ctrl+C buat stop semua."
echo ""

# Trap Ctrl+C → kill semua proses
trap "echo ''; echo '🛑 Stopping...'; kill $SERVER_PID $NGROK_PID 2>/dev/null; exit 0" INT

# Tampilin log server live
tail -f /data/data/com.termux/files/usr/tmp/onyx-server.log &
TAIL_PID=$!

# Tunggu sampai user Ctrl+C
wait
