// core/notif-transaksi.js
// Kirim notif transaksi ke Telegram + Discord

const fs = require('fs');
const path = require('path');
const tgClient = require('./telegram-client');

// Discord webhook URL (dari Discord channel settings)
const DISCORD_WEBHOOK = process.env.DISCORD_WEBHOOK_URL;

async function kirimNotifTransaksi(data) {
  const {
    userId,
    email,
    paket,
    amount,
    signature,
    wallet,
    network = 'solana',
    timestamp
  } = data;

  const waktu = new Date(timestamp).toLocaleString('id-ID', {
    dateStyle: 'full',
    timeStyle: 'short'
  });

  const pesan = `🎉 *TRANSAKSI BARU*\n\n` +
    `👤 User: \`${email || userId}\`\n` +
    `📦 Paket: *${paket}*\n` +
    `💰 Amount: *$${amount} USDC*\n` +
    `🌐 Network: ${network}\n` +
    `📅 Waktu: ${waktu}\n` +
    `🔐 Sig: \`${signature ? signature.slice(0, 20) + '...' : '-'}\`\n\n` +
    `💼 Wallet lo: \`${wallet || '-'}\`\n` +
    `✅ User udah di-upgrade ke ${paket}!`;

  // Kirim ke Telegram (nomor pribadi lo)
  try {
    const tgResult = await tgClient.kirimKeSelf(pesan);
    if (tgResult.ok) {
      console.log('✅ Notif transaksi terkirim ke Telegram');
    }
  } catch (e) {
    console.error('❌ Telegram error:', e.message);
  }

  // Kirim ke Discord webhook
  if (DISCORD_WEBHOOK) {
    try {
      await fetch(DISCORD_WEBHOOK, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          content: pesan.replace(/\\*/g, '**').replace(/\`/g, '`'),
          username: 'Onyx Bot',
          avatar_url: 'https://onyxdrake.github.io/onyx-cloud/icon-192.png'
        })
      });
      console.log('✅ Notif transaksi terkirim ke Discord');
    } catch (e) {
      console.error('❌ Discord error:', e.message);
    }
  }

  // Simpen ke log
  try {
    const logFile = path.join(__dirname, '..', 'data', 'transactions.log');
    fs.appendFileSync(logFile, `[${new Date().toISOString()}] ${JSON.stringify(data)}\n`);
  } catch {}
}

module.exports = { kirimNotifTransaksi };
